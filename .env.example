# --- NVIDIA Nemotron OCR v2 API Configuration ---
# Required for production AI packaging OCR inference (get key from https://build.nvidia.com/)
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- SQLite Database Storage ---
# Authoritative persistent inspection storage path
DATABASE_PATH=data/inspections.db

# --- Server & Networking ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Frontend Client Configuration ---
VITE_API_URL=http://localhost:8000
