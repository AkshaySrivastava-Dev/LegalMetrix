{
  "category": "household",
  "version": "2021.1",
  "description": "Statutory rule definition set for Household category pre-packaged commodities under Legal Metrology (Packaged Commodities) Rules, 2011 (as amended 2017 & 2021)",
  "rules": [
    {
      "rule_id": "RULE-HH-001",
      "category": "household",
      "field": "product_name",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Generic or common name of the household commodity must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(b)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-HH-002",
      "category": "household",
      "field": "net_quantity",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Net quantity (number, dimensions, or standard weight/measure) must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(c)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-HH-003",
      "category": "household",
      "field": "mrp",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "MRP inclusive of all taxes must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(e)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-HH-004",
      "category": "household",
      "field": "manufacturer",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Manufacturer or importer name and address must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(a)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-HH-005",
      "category": "household",
      "field": "country_of_origin",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Country of origin must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(10)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-HH-006",
      "category": "household",
      "field": "consumer_care",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Consumer care contact details must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(g)",
      "version": "2021.1"
    }
  ]
}
