{
  "category": "personal_care",
  "version": "2021.1",
  "description": "Statutory rule definition set for Personal Care category pre-packaged commodities under Legal Metrology (Packaged Commodities) Rules, 2011 (as amended 2017 & 2021)",
  "rules": [
    {
      "rule_id": "RULE-PC-001",
      "category": "personal_care",
      "field": "product_name",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Generic or common name of the personal care commodity must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(b)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-PC-002",
      "category": "personal_care",
      "field": "net_quantity",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Net weight, volume, or count must be declared in standard units",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(c)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-PC-003",
      "category": "personal_care",
      "field": "mrp",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "MRP inclusive of all taxes must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(e)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-PC-004",
      "category": "personal_care",
      "field": "manufacturer",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Manufacturer or packer name and address must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(a)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-PC-005",
      "category": "personal_care",
      "field": "country_of_origin",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Country of origin must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(10)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-PC-006",
      "category": "personal_care",
      "field": "consumer_care",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Consumer care helpline/email contact information must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(g)",
      "version": "2021.1"
    }
  ]
}
