{
  "category": "beverage",
  "version": "2021.1",
  "description": "Statutory rule definition set for Beverage category pre-packaged commodities under Legal Metrology (Packaged Commodities) Rules, 2011 (as amended 2017 & 2021)",
  "rules": [
    {
      "rule_id": "RULE-BEV-001",
      "category": "beverage",
      "field": "product_name",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Name and generic description of the beverage commodity must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(b)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-BEV-002",
      "category": "beverage",
      "field": "net_quantity",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Net volume in standard unit (e.g. ml, L) must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(c)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-BEV-003",
      "category": "beverage",
      "field": "mrp",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Maximum Retail Price (MRP) inclusive of all taxes must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(e)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-BEV-004",
      "category": "beverage",
      "field": "manufacturer",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Name and address of the manufacturer or bottler must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(a)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-BEV-005",
      "category": "beverage",
      "field": "country_of_origin",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Country of origin must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(10)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-BEV-006",
      "category": "beverage",
      "field": "date_of_manufacture",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Date/Month of manufacturing or packaging must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(d)",
      "version": "2021.1"
    },
    {
      "rule_id": "RULE-BEV-007",
      "category": "beverage",
      "field": "consumer_care",
      "required": true,
      "validation": {
        "type": "presence"
      },
      "description": "Consumer care contact details must be declared",
      "source": "Legal Metrology (Packaged Commodities) Rules, 2011 - Rule 6(1)(g)",
      "version": "2021.1"
    }
  ]
}
